# Copy this file to `.env` and fill in whichever provider you are using.
# `.env` is gitignored; this template is safe to commit.
# Do NOT put real keys in this file.

# Google AI Studio - https://aistudio.google.com  (free tier, no card)
GEMINI_API_KEY=

# Groq - https://console.groq.com  (free tier, no card)
GROQ_API_KEY=

# Optional: paid providers
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
